{
  "name": "kdca-press",
  "version": "0.5.0",
  "private": true,
  "description": "KDCA press-release editorial Skill, offline HWPX engine and MCP adapters",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node src/remote.js",
    "dev": "node --watch src/remote.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "check": "node scripts/check.js",
    "demo": "DEMO_MODE=true PUBLIC_BASE_URL=http://127.0.0.1:3000 node src/remote.js",
    "build:pages": "node scripts/build-pages.js",
    "verify:remote": "node scripts/verify-remote.js",
    "mcp:stdio": "node src/stdio.js",
    "generate": "python3 packages/kdca-press/scripts/kdca_press.py generate",
    "test:portable": "node --test test/portable.test.js",
    "build:packages": "python3 scripts/build-packages.py",
    "demo:legacy": "DEMO_MODE=true PUBLIC_BASE_URL=http://127.0.0.1:3000 node src/index.js",
    "verify:pc": "node scripts/verify-pc.js",
    "build:workers": "python3 scripts/build-worker-engine.py",
    "test:workers": "node test/workers-runtime.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@xmldom/xmldom": "0.9.12",
    "cookie-parser": "1.4.7",
    "express": "5.1.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.1.0",
    "jszip": "3.10.1",
    "kordoc": "4.21.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "playwright": "1.58.2",
    "supertest": "7.1.4",
    "wrangler": "4.149.0"
  },
  "license": "MIT",
  "overrides": {
    "@xmldom/xmldom": "0.9.12"
  }
}
