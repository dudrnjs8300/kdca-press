NODE_ENV=production
PORT=3000
PUBLIC_BASE_URL=https://your-service.example.com
# Create an OAuth App in GitHub. Callback: PUBLIC_BASE_URL/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Leave blank to allow any GitHub user. Comma-separated immutable numeric GitHub user IDs.
ALLOWED_GITHUB_IDS=
TRUST_PROXY=1
MAX_SOURCE_CHARS=24000
# Demo mode is accepted ONLY on loopback addresses and never in production.
DEMO_MODE=false

# v0.2: No permanent document library. OAuth sessions and download files are memory-only.
# Python must be available on the MCP host (already included in Docker).
PYTHON_BIN=python3
